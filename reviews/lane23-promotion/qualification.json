    "p5518": {
      "number": 5518,
      "title": "Add per-partition snapshot freshness and upload progress metrics",
      "url": "https://github.com/restatedev/restate/pull/5518",
      "state": "OPEN",
      "mergedAt": null,
      "mergeCommit": null,
      "headRefOid": "83b642c2a19a5df066b41bf2a7d86e61be60aed3",
